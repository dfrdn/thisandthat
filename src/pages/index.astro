---
import Base from '../layouts/Base.astro'
import { site } from '../site'
import ProjectCard from '../components/ProjectCard.astro'
import { projects } from '../data/projects'
import { getPosts, formatDate, shortTopic } from '../lib/writing'

const posts = await getPosts()
const builds = projects.slice(0, 3)
const ticker = [
  ['Civil Code', true],
  ['Revised Penal Code', false],
  ['R.A. 8293 · IP Code', true],
  ['R.A. 10173 · Data Privacy', false],
  ['R.A. 8792 · E-Commerce', true],
  ['Rules on Electronic Evidence', false],
  ['source code', true],
  ['prompts', false],
  ['models', true],
] as const
const article = (word: string) => (/^[aeiou]/i.test(word) ? 'an' : 'a')
const rolesLabel = `I'm ${article(site.roles[0])} ${site.roles.slice(0, -1).join(', ')}, and ${site.roles.at(-1)}.`
---
<Base>
  <section class="hero" data-ch="00 / intro">
    <div class="wrap">
      <div class="copy">
        <p class="hud">[ AI &amp; the law ]</p>
        <h1>
          <span class="w">Two</span> <span class="w">codes.</span><br /><span class="w">One</span>{' '}<span
            class="w"><em>counsel</em>.</span>
        </h1>
        <p class="role" aria-label={rolesLabel}>
          <span aria-hidden="true">I'm <span id="article">{article(site.roles[0])}</span> <span class="b">[</span> <span class="word" id="word">{site.roles[0]}</span><span class="caret"></span> <span class="b">{'}.'}</span></span>
        </p>
        <p class="lede">
          I deal with codes — the law's and the machine's. I'm a Philippine lawyer working on AI, technology, and
          intellectual property law. I teach AI to lawyers, and I build the tools I write about.
        </p>
        <div class="btns">
          <a class="btn solid" href="/writing/">Read the writing</a>
          <a class="btn line" href="/about/#contact">Work with me</a>
        </div>
      </div>
      <div class="portrait" id="portrait">
        <svg class="bg mk" viewBox="0 0 151 147" aria-hidden="true">
          <g class="pl pl-stem"><use class="stem" href="#p-stem" fill="currentColor"></use></g>
          <g class="pl pl-brace"><use class="brace" href="#p-brace" fill="currentColor"></use></g>
          <g class="pl pl-dot"><use class="dot" href="#p-dot"></use></g>
        </svg>
        <div class="fig">
          <img
            src="/img/portrait-clean.webp"
            width="652"
            height="1107"
            fetchpriority="high"
            alt="Atty. Daniel Fordan in a dark suit and striped tie, smiling"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="origin" aria-label="Origin">
    <div class="wrap">
      <code>{'[ this and that }.'}</code>
      <p>
        This site began in 2020 as <em>this and that</em> — dev, law, and everything in between. The brackets stayed
        and became the mark.
      </p>
    </div>
  </section>

  <section class="codes" id="codes" data-ch="01 / two codes" aria-labelledby="codes-h">
    <div class="stage">
      <div class="wrap">
        <div class="head">
          <p class="hud">[ 01 / two codes ]</p>
          <p class="hud hint">Scroll to compile</p>
        </div>
        <div class="grid">
          <div class="col law">
            <p class="hud">Civil Code · Art. 19</p>
            <blockquote>
              Every person must, in the exercise of his rights and in the performance of his duties, act with justice,
              give everyone his due, and observe honesty and good faith.
            </blockquote>
          </div>
          <div class="center" aria-hidden="true">
            <svg class="mk" viewBox="-10 -10 171 167">
              <use class="stem" href="#p-stem" fill="currentColor"></use>
              <use class="brace" href="#p-brace" fill="currentColor"></use>
              <use class="dot" href="#p-dot"></use>
            </svg>
          </div>
          <div class="col src">
            <p class="hud">abuse_of_rights.ts</p>
            <pre><span class="c">// the same rule, read as code</span>
<span class="k">function</span> exercise(right, duty) {'{'}
  <span class="k">return</span> act({'{'}
    justice: <span class="k">true</span>,
    giveEveryoneTheirDue: <span class="k">true</span>,
    honesty: <span class="k">true</span>,
    goodFaith: <span class="k">true</span>,
  {'}'});
{'}'}</pre>
          </div>
        </div>
        <div class="verdict">
          <h2 id="codes-h">Two codes. One counsel.</h2>
          <p>The stem is the law. The brace is the code. The full stop is the counsel: advice you can act on.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="run">
      {
        [0, 1].map(() =>
          ticker.map(([label, strong]) => <span>{strong ? <b>[ {label} ]</b> : `[ ${label} ]`}</span>),
        )
      }
    </div>
  </div>

  <section class="practice" id="practice" data-ch="02 / practice" aria-labelledby="practice-h">
    <div class="wrap">
      <div class="intro rv">
        <div>
          <p class="hud">[ 02 / what I work on ]</p>
          <h2 id="practice-h">Where the law's codes meet the machine's.</h2>
        </div>
        <p>Three threads run through everything I write, teach, and build.</p>
      </div>
      <div class="stack">
        <article class="card" style="--i:0">
          <div><p class="hud">[ governance ]</p><h3>Governing AI</h3></div>
          <ul>
            <li>AI policy and regulation</li>
            <li>Copyright and IP in AI training and outputs</li>
            <li>Fintech and data rules</li>
          </ul>
        </article>
        <article class="card" style="--i:1">
          <div><p class="hud">[ build ]</p><h3>The lawyer-builder</h3></div>
          <ul>
            <li>Building AI workflows for legal practice</li>
            <li>Lumilex, a legal-practice platform built solo</li>
            <li>What it costs, and what breaks</li>
          </ul>
        </article>
        <article class="card" style="--i:2">
          <div><p class="hud">[ teach ]</p><h3>Teaching the profession</h3></div>
          <ul>
            <li>AI for Modern Legal Practice, MLQU School of Law</li>
            <li>Workshops for law professors and practitioners</li>
            <li>Plain-language AI literacy for lawyers</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="quote" id="quote" data-ch="03 / before the codes" aria-label="A quote kept from the original site">
    <div class="wrap">
      <p class="hud">[ 03 / before the codes ]</p>
      <div>
        <blockquote id="q">All grown-ups were once children… but only few of them remember it.</blockquote>
        <cite class="hud">— Antoine de Saint-Exupéry, <i>The Little Prince</i></cite>
        <p class="note">Kept from the 2020 site.</p>
      </div>
    </div>
  </section>

  <section class="writing" id="writing" data-ch="04 / writing" aria-labelledby="writing-h">
    <div class="wrap">
      <div class="head rv">
        <div><p class="hud">[ 04 / writing ]</p><h2 id="writing-h">Two Codes</h2></div>
        <a href="/writing/" class="all">All writing →</a>
      </div>
      <div>
        <div class="post soon rv">
          <p class="hud">No. {site.upcoming.no} · Coming soon</p>
          <h3>{site.upcoming.title}</h3>
          <span class="go" aria-hidden="true"></span>
          <p>{site.upcoming.blurb}</p>
        </div>
        {
          posts.map((post) => (
            <a class="post rv" href={`/writing/${post.id}/`}>
              <p class="hud">
                {formatDate(post.data.date, 'month')} · {shortTopic(post.data.topic)}
              </p>
              <h3>{post.data.title}</h3>
              <span class="go" aria-hidden="true">
                →
              </span>
              <p>{post.data.dek}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="teach" id="teaching" data-ch="05 / teaching" aria-labelledby="teach-h">
    <div class="field">
      <div class="wrap">
        <div>
          <p class="hud">[ 05 / teaching &amp; speaking ]</p>
          <h2 id="teach-h">Teaching lawyers to read the machine.</h2>
          <p class="sub">Courses, workshops, and talks on using AI in legal practice, and on how the law should treat it.</p>
          <a class="btn line light" href="/about/#contact">Invite me to speak</a>
        </div>
        <div class="list">
          <div class="item">
            <p class="hud">MLQU School of Law · Certification</p>
            <h3>AI for Modern Legal Practice — Building Your Own AI Workflows; AI in Compliance and Regulatory Work</h3>
          </div>
          <div class="item">
            <p class="hud">Workshop · Aug 2026 · Quezon City</p>
            <h3>Syllabus-Making Using AI — LEB Capacity-Building Workshop</h3>
          </div>
          <div class="item">
            <p class="hud">Advocacy · PAFLA</p>
            <h3>Senate advocacy on open budget legislation</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="build" id="building" data-ch="06 / building" aria-labelledby="build-h">
    <div class="wrap">
      <div class="head rv">
        <div><p class="hud">[ 06 / building ]</p><h2 id="build-h">The other kind of code.</h2></div>
        <a href="/building/" class="all">All projects →</a>
      </div>
      <div class="grid">
        {
          builds.map((p) => <ProjectCard project={p} />)
        }
      </div>
    </div>
  </section>

  <section class="contact" id="contact" data-ch="07 / contact" aria-labelledby="contact-h">
    <div class="wrap">
      <p class="hud">[ 07 / contact ]</p>
      <h2 id="contact-h">A question about AI <em>and</em> the law?</h2>
      <div class="mail">
        {
          site.email && (
            <>
              <code id="mail">{site.email}</code>
              <button type="button" id="copy">
                Copy email
              </button>
            </>
          )
        }
        <a class="btn send" href="/about/#contact">Send a message</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { site } from '../site'

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  /* typing role */
  const wordEl = document.getElementById('word')
  const articleEl = document.getElementById('article')
  if (!reduce && wordEl) {
    const roles = site.roles
    let i = 0
    let n = roles[0].length
    let phase: 'type' | 'hold' | 'del' = 'hold'
    let hold = 22
    setInterval(() => {
      const w = roles[i]
      if (phase === 'type') {
        n++
        if (n >= w.length) {
          phase = 'hold'
          hold = 22
        }
      } else if (phase === 'hold') {
        if (--hold <= 0) phase = 'del'
      } else {
        n--
        if (n <= 0) {
          n = 0
          i = (i + 1) % roles.length
          // "an educator", "a lawyer": switch the article as the next word starts.
          if (articleEl) articleEl.textContent = /^[aeiou]/i.test(roles[i]) ? 'an' : 'a'
          phase = 'type'
        }
      }
      wordEl.textContent = roles[i].slice(0, n)
    }, 85)
  }

  /* quote words */
  const q = document.getElementById('q')
  const qWords: HTMLSpanElement[] = []
  if (q) {
    const words = (q.textContent ?? '').trim().split(/\s+/)
    q.textContent = ''
    words.forEach((w, k) => {
      const s = document.createElement('span')
      s.className = 'qw'
      s.textContent = w
      q.appendChild(s)
      if (k < words.length - 1) q.appendChild(document.createTextNode(' '))
      qWords.push(s)
    })
    if (reduce) qWords.forEach((s) => s.classList.add('on'))
  }

  /* scroll-scrubbed scenes */
  const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v)
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a))
  const ease = (t: number) => 1 - Math.pow(1 - t, 3)
  const codes = document.getElementById('codes')
  const quote = document.getElementById('quote')
  const teach = document.getElementById('teaching')
  const portrait = document.getElementById('portrait')
  let ticking = false

  function frame() {
    ticking = false
    const vh = innerHeight
    if (portrait) {
      // 0 while the hero is in view at the top, 1 once it has scrolled away.
      const hero = portrait.closest('section')!.getBoundingClientRect()
      portrait.style.setProperty('--sy', clamp(-hero.top / hero.height).toFixed(4))
    }
    if (codes) {
      const r = codes.getBoundingClientRect()
      const p = clamp(-r.top / (r.height - vh))
      codes.style.setProperty('--a', ease(seg(p, 0.12, 0.5)).toFixed(3))
      codes.style.setProperty('--b', ease(seg(p, 0.3, 0.66)).toFixed(3))
      codes.style.setProperty('--c', ease(seg(p, 0.62, 0.9)).toFixed(3))
    }
    if (quote && qWords.length) {
      const rq = quote.getBoundingClientRect()
      const pq = clamp((vh * 0.85 - rq.top) / (rq.height * 0.8))
      const lit = Math.round(pq * qWords.length)
      qWords.forEach((s, k) => s.classList.toggle('on', k < lit))
    }
    if (teach) {
      const rt = teach.getBoundingClientRect()
      teach.style.setProperty('--g', ease(clamp((vh - rt.top) / (vh * 0.75))).toFixed(3))
    }
  }
  if (!reduce) {
    const onScroll = () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(frame)
      }
    }
    addEventListener('scroll', onScroll, { passive: true })
    addEventListener('resize', onScroll)
    frame()
  }

  /* pointer parallax on the portrait: eased toward the cursor, desktop only */
  if (!reduce && portrait && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const hero = portrait.closest('section')!
    let tx = 0
    let ty = 0
    let x = 0
    let y = 0
    let running = false
    const step = () => {
      x += (tx - x) * 0.08
      y += (ty - y) * 0.08
      portrait.style.setProperty('--mx', x.toFixed(4))
      portrait.style.setProperty('--my', y.toFixed(4))
      if (Math.abs(tx - x) > 0.001 || Math.abs(ty - y) > 0.001) requestAnimationFrame(step)
      else running = false
    }
    const kick = () => {
      if (!running) {
        running = true
        requestAnimationFrame(step)
      }
    }
    hero.addEventListener('pointermove', (e) => {
      const r = portrait.getBoundingClientRect()
      // -1..1 relative to the portrait's centre, capped so far-off movement doesn't overshoot.
      tx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (r.width * 0.75)))
      ty = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (r.height * 0.75)))
      kick()
    })
    hero.addEventListener('pointerleave', () => {
      tx = 0
      ty = 0
      kick()
    })
  }

  /* copy email */
  const btn = document.getElementById('copy')
  const mail = document.getElementById('mail')
  if (btn && mail) {
    btn.addEventListener('click', () => {
      const done = () => {
        btn.textContent = 'Copied'
        setTimeout(() => (btn.textContent = 'Copy email'), 1600)
      }
      const fallback = () => {
        const r = document.createRange()
        r.selectNodeContents(mail)
        const s = getSelection()
        s?.removeAllRanges()
        s?.addRange(r)
        btn.textContent = 'Selected — press Copy'
      }
      if (navigator.clipboard?.writeText) navigator.clipboard.writeText(mail.textContent ?? '').then(done, fallback)
      else fallback()
    })
  }
</script>

<style>
  h2 em,
  h1 em {
    font-style: normal;
  }
  .hud + h2 {
    margin-top: 12px;
  }

  /* hero */
  .hero {
    border-bottom: 1px solid var(--line);
    overflow: clip;
  }
  .hero .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
    padding-top: clamp(56px, 9vw, 120px);
  }
  .hero .copy {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .hero h1 {
    font-size: clamp(52px, 8.4vw, 112px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin-block: 18px 30px;
  }
  .hero h1 .w {
    display: inline-block;
    animation: rise 0.9s var(--ease) both;
  }
  .hero h1 .w:nth-of-type(2) {
    animation-delay: 0.08s;
  }
  .hero h1 .w:nth-of-type(3) {
    animation-delay: 0.18s;
  }
  .hero h1 .w:nth-of-type(4) {
    animation-delay: 0.26s;
  }
  .hero h1 em {
    color: var(--brass);
  }
  .role {
    font-family: var(--mono);
    font-size: clamp(19px, 2.2vw, 26px);
    line-height: 1.4;
    margin-bottom: 22px;
    white-space: nowrap;
  }
  .role .b {
    color: var(--muted);
  }
  .role .word {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.15em;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    vertical-align: -0.12em;
    margin-left: 2px;
    background: var(--brass);
    animation: blink 1s steps(1) infinite;
  }
  .lede {
    max-width: 34em;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .portrait {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 151 / 147;
    justify-self: end;
  }
  .portrait .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--backdrop);
  }
  .portrait .bg use {
    transform-box: fill-box;
  }
  .portrait .bg .stem {
    animation: fromLeft 1.2s 0.2s var(--ease) both;
  }
  .portrait .bg .brace {
    animation: fromRight 1.2s 0.35s var(--ease) both;
  }
  .portrait .bg .dot {
    fill: var(--brass);
    animation: drop 0.7s 1.1s cubic-bezier(0.3, 1.5, 0.5, 1) both;
  }
  /* Parallax: on scroll the strokes rise at different speeds while the portrait sinks;
     with a mouse, the layers shift against each other. Units inside the SVG are viewBox units. */
  .portrait .pl-stem {
    transform: translate(calc(var(--mx, 0) * -2px), calc(var(--sy, 0) * -10px + var(--my, 0) * -1.5px));
  }
  .portrait .pl-brace {
    transform: translate(calc(var(--mx, 0) * -3.5px), calc(var(--sy, 0) * -18px + var(--my, 0) * -2.5px));
  }
  .portrait .pl-dot {
    transform: translate(calc(var(--mx, 0) * -5px), calc(var(--sy, 0) * -30px + var(--my, 0) * -4px));
  }
  .portrait .fig {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--mx, 0) * 10px), calc(var(--sy, 0) * 48px + var(--my, 0) * 6px), 0);
    will-change: transform;
  }
  .portrait img {
    position: absolute;
    left: 1%;
    bottom: 0;
    width: 51%;
    height: auto;
    max-width: none;
    animation: rise 1s 0.15s var(--ease) both;
  }
  @media (max-width: 820px) {
    .hero .wrap {
      grid-template-columns: 1fr;
    }
    .hero .copy {
      padding-bottom: 0;
    }
    .portrait {
      max-width: 420px;
      justify-self: start;
    }
  }
  @media (max-width: 380px) {
    .role {
      font-size: 17px;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(0.35em);
      opacity: 0.2;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes fromLeft {
    from {
      transform: translateX(-60%);
      opacity: 0.15;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes fromRight {
    from {
      transform: translateX(70%);
      opacity: 0.15;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes drop {
    from {
      transform: translateY(-220%);
      opacity: 0.15;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }

  /* origin strip */
  .origin {
    border-bottom: 1px solid var(--line);
    background: var(--raised);
  }
  .origin .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 32px;
    padding-block: 24px;
  }
  .origin code {
    font-size: 20px;
  }
  .origin p {
    flex: 1 1 380px;
    min-width: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* two codes scene */
  .codes {
    position: relative;
    height: 280vh;
  }
  .codes .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .codes .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: clamp(20px, 4vh, 44px);
  }
  .codes .grid {
    --gap: clamp(16px, 3vw, 40px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 0.7fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .col {
    padding: clamp(18px, 2.4vw, 32px);
    border: 1px solid var(--line);
    background: var(--raised);
    min-width: 0;
    opacity: calc(1 - var(--a, 0) * 0.86);
  }
  .col.law {
    transform-origin: left center;
    transform: translateX(calc(var(--a, 0) * var(--gap) * 0.5)) scale(calc(1 - var(--a, 0) * 0.08));
  }
  .col.src {
    transform-origin: right center;
    transform: translateX(calc(var(--a, 0) * var(--gap) * -0.5)) scale(calc(1 - var(--a, 0) * 0.08));
  }
  .col .hud {
    margin-bottom: 14px;
  }
  .col.law blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(18px, 1.8vw, 23px);
    line-height: 1.5;
  }
  .col.src pre {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(12px, 1.15vw, 14.5px);
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .col.src .k {
    color: var(--brass);
  }
