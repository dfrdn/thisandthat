---
import Base from '../layouts/Base.astro'
import { photos } from '../data/photos'
---
<Base title="Photography" description="Photographs by Daniel Fordan, desaturated toward slate.">
  <section class="wrap intro-block">
    <p class="hud">Photography</p>
    <h1>Frames, not files.</h1>
    <p class="lede">The one code I don't have to read: light. Photographs from outside the office, in black and white.</p>
  </section>

  <section class="wrap gallery" aria-label="Photographs">
    {
      photos.length ? (
        photos.map((p) => (
          <figure class="rv">
            <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" />
            {p.caption && <figcaption class="hud">{p.caption}</figcaption>}
          </figure>
        ))
      ) : (
        <div class="empty">
          <p class="hud">[ in the darkroom ]</p>
          <p>The first set is still being edited. In the meantime, there is plenty to read.</p>
          <a class="btn line" href="/writing">Read the writing</a>
        </div>
      )
    }
  </section>
</Base>

<style>
  .gallery {
    columns: 3 300px;
    column-gap: 20px;
    padding-bottom: clamp(72px, 10vw, 120px);
  }
  figure {
    margin: 0 0 20px;
    break-inside: avoid;
    background: var(--slate-soft);
  }
  figure img {
    display: block;
    width: 100%;
    filter: grayscale(1);
  }
  figcaption {
    padding: 10px 0 0;
    background: var(--paper);
  }
  .empty {
    column-span: all;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(32px, 5vw, 56px);
    border: 1px solid var(--line);
    background: var(--raised);
  }
  .empty p:not(.hud) {
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.3;
    max-width: 28em;
  }
</style>
