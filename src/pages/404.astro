---
import Base from '../layouts/Base.astro'
---
<Base title="Not found">
  <section class="wrap intro-block">
    <p class="hud">[ 404 / not found ]</p>
    <h1>No such provision.</h1>
    <p class="lede">The page you were looking for has been repealed, renumbered, or never enacted.</p>
    <p class="go"><a class="btn solid" href="/">Back home</a> <a class="btn line" href="/writing">Read the writing</a></p>
  </section>
</Base>

<style>
  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    padding-bottom: 96px;
  }
</style>
