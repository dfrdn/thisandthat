---
import Base from '../../layouts/Base.astro'
import { site } from '../../site'
import { getPosts, formatDate, slugify } from '../../lib/writing'

const posts = await getPosts()
const topics = [...new Set(posts.map((p) => p.data.topic))]
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))]
---
<Base
  title="Writing"
  description="Essays and short notes on AI, technology, and intellectual property — each one ends with the short answer."
>
  <section class="wrap intro-block">
    <p class="hud">Writing</p>
    <h1>Both kinds of code, read closely.</h1>
    <p class="lede">Essays and short notes on AI, technology, and intellectual property — each one ends with the short answer.</p>
  </section>

  {
    topics.length > 1 && (
      <div class="wrap chips" role="group" aria-label="Filter by topic">
        <button type="button" data-topic="all" aria-pressed="true">
          All
        </button>
        {topics.map((t) => (
          <button type="button" data-topic={slugify(t)} aria-pressed="false">
            {t}
          </button>
        ))}
      </div>
    )
  }

  <section class="wrap featured" aria-label="Featured series">
    <div class="feature">
      <div class="side">
        <p class="hud">Two Codes / No. {site.upcoming.no} · Coming soon</p>
        <div>
          <h2>{site.upcoming.title}</h2>
          <p>The series that pairs one codal provision with one idea from software, and ends with the short answer.</p>
        </div>
      </div>
      <div class="pair" aria-hidden="true">
        <code>{site.upcoming.pair[0]}</code>
        <span>×</span>
        <code>{site.upcoming.pair[1]}</code>
      </div>
    </div>
  </section>

  <section class="wrap archive" aria-labelledby="archive-h">
    <div class="archive-head">
      <h2 id="archive-h" class="hud">From the archive · {years.join(', ')}</h2>
      <span class="hud count" id="count">{posts.length} essays</span>
    </div>
    {
      posts.map((post) => (
        <a class="row" href={`/writing/${post.id}`} data-topic={slugify(post.data.topic)}>
          <div class="meta">
            <p class="hud">{formatDate(post.data.date, 'short')}</p>
            <p class="hud">{post.data.topic}</p>
          </div>
          <div class="body">
            <h3>{post.data.title}</h3>
            <p>{post.data.dek}</p>
          </div>
        </a>
      ))
    }
  </section>
</Base>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.chips button'))
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'))
  const count = document.getElementById('count')
  const apply = (topic: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === topic)))
    let shown = 0
    rows.forEach((r) => {
      const on = topic === 'all' || r.dataset.topic === topic
      r.hidden = !on
      if (on) shown++
    })
    if (count) count.textContent = `${shown} ${shown === 1 ? 'essay' : 'essays'}`
  }
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.topic ?? 'all')))
</script>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 40px;
  }
  .chips button {
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: none;
    color: var(--ink);
    font: 500 12px/18px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .chips button:hover {
    border-color: var(--ink);
  }
  .chips button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .featured {
    padding-bottom: 64px;
  }
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    background: var(--slate);
    color: var(--on-slate);
  }
  .feature .hud {
    color: inherit;
  }
  .side {
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 300px;
  }
  .side h2 {
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  .side p:not(.hud) {
    max-width: 460px;
  }
  .pair {
    background: var(--slate-deep);
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    min-height: 240px;
  }
  .pair code {
    font-size: 18px;
    line-height: 28px;
  }
  .pair span {
    font-family: var(--serif);
    font-size: 40px;
    line-height: 40px;
    color: var(--brass-on-slate);
  }

  .archive {
    padding-bottom: 96px;
  }
  .archive-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
  }
  .archive-head h2 {
    font-family: var(--mono);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 8px 48px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .row[hidden] {
    display: none;
  }
  .meta .hud + .hud {
    margin-top: 4px;
  }
  .body h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  .row:hover h3 {
    color: var(--brass);
  }
  .body p {
    font-size: 15px;
    line-height: 24px;
    color: var(--muted);
    max-width: 44em;
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
    }
    .meta {
      display: flex;
      gap: 16px;
    }
    .meta .hud + .hud {
      margin-top: 0;
    }
  }
</style>
